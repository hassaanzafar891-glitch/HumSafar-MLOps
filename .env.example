# Copy to .env locally. Do not commit real secrets or application databases.
# Generate a secret: .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
# Default when omitted: absolute workspace backend/var/humsafar.db
# Relative URLs are relative to the process working directory (use project root).
DATABASE_URL=sqlite:///backend/var/humsafar.db
AUTO_INIT_DB=true
# Later PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/humsafar
# Requires psycopg and an independently configured PostgreSQL server.
