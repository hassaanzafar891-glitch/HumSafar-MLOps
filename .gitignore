# Local credentials. Safe, reviewed examples remain versioned at any depth.
.env
.env.*
*.env
!.env.example
.aws/
.ssh/
secrets/
credentials.json
service-account*.json
client_secret*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
.netrc
.pypirc

# Python environments, build products and tool caches.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# JavaScript dependencies, generated bundles and browser-test artifacts.
node_modules/
.npm-cache/
.vite/
dist/
build/
coverage/
test-results/
playwright-report/
blob-report/

# Application state, SQLite (including sidecars), logs and temporary files.
/backend/var/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.log
logs/
tmp/
temp/
.cache/
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
.idea/

# Workspace-only MLOps state and local credentials/remotes.
/.local/
/.mlops/
mlruns/
mlartifacts/
.mlflow/
/.dvc/config.local
/.dvc/cache/
/.dvc/tmp/
/.dvc/remote/
/.dvc/remotes/
dvc-cache/
dvc-remote/
dvc_remote/
dvc-remotes/

# ML payloads stay local or in DVC. Keep pointers and reviewed registry metadata.
/data/**
!/data/
!/data/**/
!/data/**/*.dvc
/models/**
!/models/
!/models/**/
!/models/**/README.md
!/models/**/*.dvc
!/models/registry/*.json
# Cache directories must stay excluded even when they contain README files.
/models/hf_cache/
/models/minilm/encoder/

# Catch accidentally copied model weights outside the canonical models folder.
*.joblib
*.pkl
*.pickle
*.npz
*.npy
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
